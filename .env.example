# Development/demo defaults only. Copy to .env and replace every CHANGE_ME value.
FLOOD_ENVIRONMENT=development
FLOOD_DB_PATH=/app/data/flood_warning_system.db
FLOOD_REQUIRE_HTTPS=0
FLOOD_TRUST_PROXY_HEADERS=1
FLOOD_SUPERVISOR_LOOP_ENABLED=0
FLOOD_IDENTITY_ASSERTION_MAX_AGE_SECONDS=120
# Demo Compose only. Never enable in production.
FLOOD_ALLOW_DEV_IDENTITY_HEADERS=0

# Required in production; generate and store these in a secret manager.
FLOOD_DATA_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
FLOOD_TRUSTED_IDENTITY_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
FLOOD_BACKUP_MANIFEST_SECRET=CHANGE_ME_INDEPENDENT_32_BYTE_SECRET
FLOOD_INSTANCE_ID=district-simulation-01

# PostGIS shadow migration pilot. The Compose default is simulation-only and must not be reused in production.
FLOOD_POSTGRES_DB=flood
FLOOD_POSTGRES_USER=flood
FLOOD_POSTGRES_PASSWORD=CHANGE_ME_POSTGIS_PASSWORD
FLOOD_POSTGRES_PORT=5432
